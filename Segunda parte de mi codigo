import sqlite3
import tkinter as tk
from tkinter import messagebox
from tkinter import ttk

CORRECT_USER = "admin"
CORRECT_PASSWORD = "1234"

def verify_login():
    user = entry_user.get()
    password = entry_pass.get()

    if user == CORRECT_USER and password == CORRECT_PASSWORD:
        login_window.withdraw()  # Hide login
        start_system()
    else:
        messagebox.showerror("Error", "Incorrect username or password")


def start_system():
    global window, entry_name, entry_brand, entry_quantity, table
    global conn, cursor

    conn = sqlite3.connect("beauty.db")
    cursor = conn.cursor()

    cursor.execute("""
    CREATE TABLE IF NOT EXISTS products (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT,
        brand TEXT,
        quantity INTEGER
    )
    """)
    conn.commit()

    def add():
        name = entry_name.get()
        brand = entry_brand.get()
        quantity = entry_quantity.get()

        if not name or not brand or not quantity:
            messagebox.showwarning("Error", "Complete all fields")
            return

        cursor.execute(
            "INSERT INTO products (name, brand, quantity) VALUES (?, ?, ?)",
            (name, brand, int(quantity))
        )
        conn.commit()

        messagebox.showinfo("Success", "Product added")
        clear()
        list_items()

    def list_items():
        for row in table.get_children():
            table.delete(row)

        cursor.execute("SELECT name, brand, quantity FROM products")
        for p in cursor.fetchall():
            table.insert("", tk.END, values=(p[0], p[1], p[2]))

    def update():
        name = entry_name.get()
        quantity = entry_quantity.get()

        cursor.execute(
            "UPDATE products SET quantity=? WHERE name=?",
            (int(quantity), name)
        )
        conn.commit()

        messagebox.showinfo("Success", "Product updated")
        list_items()

    def delete():
        name = entry_name.get()

        cursor.execute("DELETE FROM products WHERE name=?", (name,))
        conn.commit()

        messagebox.showinfo("Success", "Product deleted")
        list_items()

    def clear():
        entry_name.delete(0, tk.END)
        entry_brand.delete(0, tk.END)
        entry_quantity.delete(0, tk.END)

   
    window = tk.Toplevel()
    window.title("Beauty System")
    window.geometry("500x500")
    window.configure(bg="#ffe4ec")

    tk.Label(window, text="Beauty System", font=("Arial", 16, "bold"),
             bg="#ffe4ec", fg="#d63384").pack(pady=10)

    tk.Label(window, text="Name", bg="#ffe4ec").pack()
    entry_name = tk.Entry(window)
    entry_name.pack(pady=5)

    tk.Label(window, text="Brand", bg="#ffe4ec").pack()
    entry_brand = tk.Entry(window)
    entry_brand.pack(pady=5)

    tk.Label(window, text="Quantity", bg="#ffe4ec").pack()
    entry_quantity = tk.Entry(window)
    entry_quantity.pack(pady=5)

    tk.Button(window, text="Add", bg="#eeb5bf", fg="white", width=20, command=add).pack(pady=5)
    tk.Button(window, text="List", bg="#ccbaf0", fg="white", width=20, command=list_items).pack(pady=5)
    tk.Button(window, text="Update", bg="#8ce9cd", fg="white", width=20, command=update).pack(pady=5)
    tk.Button(window, text="Delete", bg="#a37a7e", fg="white", width=20, command=delete).pack(pady=5)

    table = ttk.Treeview(window, columns=("Name", "Brand", "Quantity"), show="headings")
    table.heading("Name", text="Name")
    table.heading("Brand", text="Brand")
    table.heading("Quantity", text="Quantity")

    table.pack(pady=10)

    list_items()

login_window = tk.Tk()
login_window.title("Login")
login_window.geometry("300x200")

tk.Label(login_window, text="Username").pack(pady=5)
entry_user = tk.Entry(login_window)
entry_user.pack()

tk.Label(login_window, text="Password").pack(pady=5)
entry_pass = tk.Entry(login_window, show="*")
entry_pass.pack()

tk.Button(login_window, text="Login", command=verify_login).pack(pady=10)

login_window.mainloop()
